# Browser build: same-origin authenticated gateway; never include CouchDB credentials.
# Set blank only for deliberately local-only learning storage.
VITE_LEARNING_SYNC_URL=/couchdb/my/
# Explicit npm run dev identity fixture only. Keep blank when testing login/sync.
VITE_DEV_USER_ID=

# Node server (copy to ignored .env.server; chmod 600; replace placeholders).
# Production requires HTTPS public origin and Secure=true, even behind a TLS proxy.
NODE_ENV=production
STUDY_BIND_HOST=127.0.0.1
STUDY_PORT=3000
STUDY_PUBLIC_ORIGIN=https://study.example.invalid
COUCHDB_INTERNAL_URL=http://127.0.0.1:5984
COUCHDB_USERNAME=replace-with-internal-couchdb-admin
COUCHDB_PASSWORD=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
# Absolute session lifetime: 7 days; no sliding renewal. Maximum 30 days.
SESSION_MAX_AGE_SECONDS=604800

# Optional integration test ONLY, read from ignored .env.couchdb-test.
# Use a disposable CouchDB instance, never production.
# COUCHDB_TEST_URL=http://127.0.0.1:15984
# COUCHDB_TEST_USERNAME=replace-with-disposable-couchdb-admin
# COUCHDB_TEST_PASSWORD=replace-with-a-disposable-secret
# STUDY_COUCHDB_INTEGRATION=1  # set automatically by test:server:integration
