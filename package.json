{
  "name": "drillmcq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:server:integration": "STUDY_COUCHDB_INTEGRATION=1 node --env-file-if-exists=.env.couchdb-test node_modules/vitest/vitest.mjs run --config vitest.server.config.ts server/tests/real-couch.test.ts",
    "server": "npm run build:server && node --env-file-if-exists=.env.server dist-server/index.js",
    "create-study-user": "npm run build:server && node --env-file-if-exists=.env.server dist-server/scripts/create-user.js"
  },
  "dependencies": {
    "events": "^3.3.0",
    "pouchdb-browser": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "@types/node": "^22.20.4"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
