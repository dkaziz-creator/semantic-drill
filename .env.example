# Optional same-origin authenticated gateway. Blank = local learning storage only.
# This is NOT a concrete CouchDB database URL. Never put credentials here.
VITE_LEARNING_SYNC_URL=
# Enable only after the trusted gateway is provided:
# VITE_LEARNING_SYNC_URL=/couchdb/my/

# Explicit local dev identity fixture (npm run dev only; ignored in production).
# Use a server-assigned UUID for a pilot account. No automatic legacy import.
# Without a dev fixture, identity is fetched from /api/auth/me.
VITE_DEV_USER_ID=
